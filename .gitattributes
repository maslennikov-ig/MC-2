*.ico binary
*.webp binary
*.avif binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.wav binary
*.ogg binary
*.flac binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.docx binary
*.pptx binary

# Lock file - no diff
pnpm-lock.yaml -diff
