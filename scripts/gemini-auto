#!/usr/bin/expect -f

# Отключаем глобальный таймаут ожидания
set timeout -1

# Выводим приветственное сообщение, чтобы пользователь знал, что обертка работает
puts "\n========================================================"
puts "🚀 Запуск через gemini-auto (Expect Wrapper)"
puts "🛡️ Автоматический перехват 'High Demand' (503 Error) АКТИВИРОВАН."
puts "========================================================\n"

# Запускаем оригинальный Gemini CLI с передачей всех аргументов командной строки
spawn gemini {*}$argv

# Переходим в режим прозрачного взаимодействия с перехватом вывода от сервера (-o)
interact {
    -o -re "1\\. Keep trying.*2\\. Stop" {
        send "1\r"
        puts "\n\[Expect-Скрипт\] Обнаружена перегрузка (High Demand). Отправлен автоматический сигнал продолжения (1)."
    }
}
