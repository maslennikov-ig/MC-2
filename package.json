{
  "name": "megacampus-monorepo",
  "version": "0.31.41",
  "private": true,
  "description": "MegaCampusAI - Stage 0: Foundation Infrastructure",
  "scripts": {
    "dev": "pnpm --filter course-gen-platform dev",
    "nlm:preflight": "bash ./scripts/nlm-preflight.sh",
    "nlm:stage7-preflight": "bash ./scripts/nlm-stage7-preflight.sh",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter @megacampus/course-gen-platform --filter @megacampus/shared-types test:unit",
    "test:contract": "pnpm --filter @megacampus/course-gen-platform test:contract",
    "test:integration": "pnpm -r --filter @megacampus/course-gen-platform --filter @megacampus/web test:integration",
    "test:integration:ci": "pnpm -r --filter @megacampus/course-gen-platform --filter @megacampus/web test:integration:ci",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "pnpm -r type-check",
    "supabase": "supabase",
    "supabase:status": "supabase status",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:migration:up": "supabase migration up",
    "supabase:migration:new": "supabase migration new",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.1.0",
    "supabase": "^2.106.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "jws": ">=4.0.1",
      "body-parser": ">=2.2.1",
      "mdast-util-to-hast": ">=13.2.1",
      "@babel/plugin-transform-modules-systemjs": "7.29.7",
      "@langchain/core": "1.1.48",
      "ajv@<6.14.0": "6.15.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.20.0",
      "brace-expansion@<1.1.13": "1.1.15",
      "brace-expansion@>=2.0.0 <2.0.3": "2.1.1",
      "diff": ">=5.2.2",
      "fast-uri": "3.1.2",
      "flatted": "3.4.2",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "minimatch@<3.1.4": "3.1.5",
      "minimatch@>=5.0.0 <5.1.8": "5.1.9",
      "minimatch@>=9.0.0 <9.0.7": "9.0.9",
      "path-to-regexp@<0.1.13": "0.1.13",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.10": "8.5.15",
      "qs": "6.15.2",
      "rollup@<2.80.0": "2.80.0",
      "rollup@>=4.0.0 <4.59.0": "4.61.1",
      "serialize-javascript": "7.0.5",
      "tar": "7.5.16",
      "undici@>=7.0.0 <7.24.0": "7.27.2",
      "uuid@<11.1.1": "11.1.1",
      "uuid@>=13.0.0 <13.0.1": "13.0.2",
      "webpack@>=5.49.0 <=5.104.0": "5.107.2",
      "ws@>=8.0.0 <8.20.1": "8.21.0",
      "yaml@>=1.0.0 <1.10.3": "1.10.3",
      "zustand": ">=5.0.0",
      "shiki": "^3.19.0"
    }
  },
  "dependencies": {
    "jsdom": "^29.1.1"
  }
}
