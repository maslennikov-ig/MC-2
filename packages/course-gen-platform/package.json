{
  "name": "@megacampus/course-gen-platform",
  "version": "0.31.41",
  "private": true,
  "type": "module",
  "description": "Main API server for MegaCampusAI course generation platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app-router": {
      "types": "./dist/server/app-router.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/orchestrator/worker-entrypoint.ts",
    "dev:worker:stage6": "STAGE6_WORKER=true tsx watch src/orchestrator/worker-entrypoint.ts",
    "dev:worker:stage7": "tsx watch src/stages/stage7-enrichments/worker-entrypoint.ts",
    "dev:worker:safe": "pkill -f 'worker-entrypoint' 2>/dev/null; sleep 1; tsx watch src/orchestrator/worker-entrypoint.ts",
    "kill:workers": "pkill -f 'worker-entrypoint' 2>/dev/null && echo 'Workers killed' || echo 'No workers running'",
    "build": "tsc -p tsconfig.json && tsup",
    "build:types": "pnpm --filter @megacampus/shared-logger build && pnpm --filter @megacampus/shared-types exec tsc --build --force && pnpm --filter @megacampus/shared-utils build && tsc --build --force --emitDeclarationOnly",
    "build:processor": "tsup",
    "generate:config-seed": "tsx src/build/generate-config-seed.ts",
    "prebuild": "tsx src/build/generate-config-seed.ts",
    "start": "tsx dist/server/index.js",
    "start:worker": "node dist/orchestrator/worker-entrypoint.js",
    "start:worker:stage7": "node dist/stages/stage7-enrichments/worker-entrypoint.js",
    "test": "vitest run --config vitest.config.unit.ts",
    "test:watch": "vitest --config vitest.config.unit.ts",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:full": "vitest run",
    "test:contract": "vitest run --config vitest.config.contract.ts",
    "test:integration": "vitest run tests/integration",
    "test:integration:ci": "vitest run --config vitest.config.integration-ci.ts",
    "test:fixtures": "vitest run tests/fixtures/seed-database.test.ts",
    "test:rls": "cd ../.. && supabase test db --workdir packages/course-gen-platform",
    "test:all": "pnpm test:full && pnpm test:rls",
    "seed": "tsx tests/fixtures/seed-database.ts",
    "seed:clean": "tsx tests/fixtures/seed-database.ts clean",
    "verify:qdrant": "tsx tools/verify/verify-qdrant-connection.ts",
    "qdrant:create-collection": "tsx src/shared/qdrant/create-collection.ts",
    "qdrant:bootstrap": "tsx src/shared/qdrant/create-collection.ts",
    "qdrant:verify": "tsx tools/qdrant/verify-collection.ts",
    "qdrant:reindex": "tsx tools/qdrant/reindex-course-embeddings.ts",
    "qdrant:reindex:plan": "tsx tools/qdrant/reindex-course-embeddings.ts plan",
    "qdrant:reindex:execute": "tsx tools/qdrant/reindex-course-embeddings.ts execute",
    "qdrant:reindex:verify": "tsx tools/qdrant/reindex-course-embeddings.ts verify",
    "qdrant:source-recovery": "tsx tools/qdrant/source-recovery.ts",
    "qdrant:source-recovery:plan": "tsx tools/qdrant/source-recovery.ts plan",
    "qdrant:source-recovery:execute": "tsx tools/qdrant/source-recovery.ts execute",
    "qdrant:source-recovery:verify": "tsx tools/qdrant/source-recovery.ts verify",
    "qdrant:source-recovery:rollback": "tsx tools/qdrant/source-recovery.ts rollback",
    "qdrant:snapshot": "tsx tools/qdrant/snapshot.ts",
    "qdrant:restore-drill": "tsx tools/qdrant/restore-drill.ts",
    "cleanup:docling-cache": "tsx tools/maintenance/cleanup-docling-cache.ts",
    "migration:document-evidence-index:apply": "TMPDIR=${TMPDIR:-/tmp} tsx scripts/migrations/document-evidence-observability-index.ts apply",
    "migration:document-evidence-index:rollback": "TMPDIR=${TMPDIR:-/tmp} tsx scripts/migrations/document-evidence-observability-index.ts rollback",
    "migration:document-evidence-observability:apply": "TMPDIR=${TMPDIR:-/tmp} tsx scripts/migrations/document-evidence-observability-index.ts apply-all",
    "migration:document-evidence-observability:rollback": "TMPDIR=${TMPDIR:-/tmp} tsx scripts/migrations/document-evidence-observability-index.ts rollback-all",
    "migration:document-evidence-approved:apply": "TMPDIR=${TMPDIR:-/tmp} tsx scripts/migrations/document-evidence-approved.ts apply",
    "migration:document-evidence-approved:rollback": "TMPDIR=${TMPDIR:-/tmp} tsx scripts/migrations/document-evidence-approved.ts rollback",
    "lint": "eslint src --max-warnings=95",
    "type-check": "pnpm --filter @megacampus/shared-logger build && pnpm --filter @megacampus/shared-types exec tsc --build --force && pnpm --filter @megacampus/shared-utils build && tsc --noEmit",
    "analyze:bundle": "tsx scripts/analyze-processor-bundle.ts",
    "benchmark-llm": "tsx scripts/benchmark-llm/index.ts",
    "benchmark:docling": "tsx scripts/docling-quality-benchmark.ts",
    "smoke:career-playbook:preflight": "TMPDIR=${TMPDIR:-/tmp} tsx scripts/career-playbook-smoke-preflight.ts",
    "smoke:career-playbook:live": "TMPDIR=${TMPDIR:-/tmp} tsx scripts/career-playbook-live-smoke.ts"
  },
  "dependencies": {
    "@bull-board/api": "^5.14.0",
    "@bull-board/express": "^5.14.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.4.1",
    "@langchain/openai": "^1.4.7",
    "@langchain/textsplitters": "^1.0.1",
    "@megacampus/shared-logger": "workspace:*",
    "@megacampus/shared-types": "workspace:*",
    "@megacampus/shared-utils": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@qdrant/js-client-rest": "1.18.0",
    "@sentry/node": "^10.38.0",
    "@supabase/supabase-js": "^2.87.2",
    "@trpc/server": "^11.9.0",
    "any-ascii": "^0.3",
    "archiver": "^7",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "bullmq": "5.66.3",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "dompurify": "^3.4.9",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "fast-levenshtein": "^3.0.0",
    "fast-xml-parser": "^5.8.0",
    "form-data": "^4",
    "fractional-indexing": "^3.2.0",
    "franc-min": "^6.2.0",
    "ioredis": "^5.8.2",
    "jsdom": "^29.1.1",
    "jsonrepair": "^3.13.1",
    "krippendorff": "^0.1.0",
    "mammoth": "^1.12.0",
    "markdownlint": "^0.40.0",
    "mermaid": "^11.15.0",
    "nanoid": "^5.1.6",
    "openai": "^6.18.0",
    "p-limit": "^7.2.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "playwright": "^1.57.0",
    "sharp": "^0.34.5",
    "snowball-stemmers": "^0.6.0",
    "strip-ansi": "^7.1.2",
    "tiktoken": "^1.0.22",
    "turndown": "^7.2.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@trpc/client": "^11.9.0",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/tar": "^6.1.13",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.8",
    "js-yaml": "^4.1.1",
    "json5": "^2.2.3",
    "nock": "^14.0.10",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.3",
    "supabase": "^2.106.0",
    "tar": "^7.5.2",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.8"
  }
}
