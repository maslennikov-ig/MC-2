# Supabase Configuration
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# Database Direct Connection (for pgTAP tests)
# Format: postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
# Get from: https://app.supabase.com/project/<your-project>/settings/database
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Redis Configuration (BullMQ)
REDIS_URL=redis://localhost:6379

# Qdrant Configuration
QDRANT_URL=https://your-cluster.qdrant.cloud
QDRANT_API_KEY=your-qdrant-api-key-here

# Jina AI Embeddings
JINA_API_KEY=your-jina-api-key-here

# OAuth Providers (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Providers (GitHub)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Supabase Storage bucket for enrichment assets (covers, cards, etc.)
ENRICHMENTS_STORAGE_BUCKET=course-enrichments

# Local enrichment storage (recommended for server/dev to avoid Supabase egress)
# When true, Stage 7 stores assets on local filesystem and serves via /storage/enrichments/*
USE_LOCAL_STORAGE=false
ENRICHMENTS_LOCAL_PATH=/app/data/enrichments
ENRICHMENTS_PUBLIC_URL=/storage/enrichments
# Optional absolute base URL override for playback links (e.g., http://localhost:3456)
# ENRICHMENTS_PUBLIC_BASE_URL=

# NotebookLM Bridge (Stage 7 NLM Audio/Video)
# Shared bearer token for API/worker -> bridge requests.
NOTEBOOKLM_BRIDGE_TOKEN=
# Local bridge URL used by backend/worker in local dev.
NOTEBOOKLM_BRIDGE_URL=http://127.0.0.1:8010
# API/worker HTTP timeout when calling NotebookLM bridge (default: 60 minutes).
NOTEBOOKLM_BRIDGE_TIMEOUT_MS=3600000
# Per-poll HTTP timeout for async task status/result requests (default: 30 seconds).
NOTEBOOKLM_BRIDGE_POLL_REQUEST_TIMEOUT_MS=30000
NOTEBOOKLM_LOG_LEVEL=INFO
# Preferred for dev/stage/prod: inline auth JSON payload (storage_state.json content).
# Leave NOTEBOOKLM_STORAGE_PATH empty when this is set.
NOTEBOOKLM_AUTH_JSON=
# Local file fallback (used when NOTEBOOKLM_AUTH_JSON is empty).
NOTEBOOKLM_STORAGE_STATE_DIR=./secrets/notebooklm
NOTEBOOKLM_STORAGE_PATH=/app/secrets/notebooklm/storage_state.json
NOTEBOOKLM_HOME=/app/secrets/notebooklm
# Bridge-side generation and queue wait timeouts (default: 60 minutes).
NOTEBOOKLM_GENERATION_TIMEOUT_SECONDS=3600
NOTEBOOKLM_QUEUE_WAIT_TIMEOUT_SECONDS=3600
# Per-request HTTP timeout used by notebooklm-py polling (keep much smaller than generation timeout).
NOTEBOOKLM_HTTP_TIMEOUT_SECONDS=60
# How many transient poll errors bridge tolerates before failing.
NOTEBOOKLM_POLL_ERROR_RETRY_LIMIT=12

# Multi-tenancy Configuration
JWT_SECRET=your-jwt-secret-here

# API Key Encryption
# Generate with: openssl rand -hex 32
# This key is used to encrypt API keys stored in the database (AES-256-GCM)
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# Docling MCP Server Configuration
DOCLING_MCP_URL=http://docling-mcp:8000/sse
DOCLING_MCP_TIMEOUT=300000

# Chat Feature Flags (phased rollout; set to 'true' to enable)
CHAT_INTENT_ROUTING_ENABLED=false          # Auto-intent classification (Tier 0 regex + Tier 1 LLM)
CHAT_STRUCTURAL_PROPOSALS_ENABLED=false    # Surgical add/delete/move operations via stable IDs

# Guard: reject course_structure writes without stable IDs (enable after backfill)
COURSE_STABLE_IDS_REQUIRED=false

# Course Nodes Feature Flags (Phase 4: flat relational course_nodes table)
# Dual-write: write to both course_structure JSONB and course_nodes table
COURSE_NODES_DUAL_WRITE_ENABLED=false
# Read from course_nodes instead of course_structure JSONB
COURSE_NODES_READ_ENABLED=false
# Parity check: after dual-write, read back and compare with original structure
COURSE_NODES_PARITY_CHECK_ENABLED=false

# Web Push Notifications (VAPID keys)
# Generate with: node packages/web/scripts/generate-vapid-keys.js
WEB_PUSH_EMAIL=admin@megacampus.ru
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key-here
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=your-vapid-public-key-here
