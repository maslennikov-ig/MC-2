{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@megacampus/shared-types": ["../shared-types/src"],
      "@megacampus/shared-types/*": ["../shared-types/src/*"],
      "@megacampus/shared-logger": ["../shared-logger/src"],
      "@megacampus/shared-logger/*": ["../shared-logger/src/*"]
    }
  },
  "references": [{ "path": "../shared-types" }, { "path": "../shared-logger" }],
  "include": ["src/**/*"]
}
