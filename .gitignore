# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Playwright MCP artifacts ---
.playwright-mcp/
.playwright-cli/

# --- Agent/Codex artifacts ---
.agents/
.codex/*
!.codex/
!.codex/skills/
!.codex/skills/**
!.codex/orchestrator.toml
!.codex/handoff.md
# The durable half of the handoff, extracted 2026-08-03 so it stops competing for room under the
# 200-line current-state cap. Tracked for the same reason handoff.md is: agents read it first.
!.codex/repository-failure-modes.md
!.codex/project-index.md
!.codex/report-template.md
!.codex/stage-artifact-template.md
!.codex/verification-manifest.json
!.codex/verification-manifest-template.json
!.codex/subagent-task-contract.md
!.codex/subagent-spawn-template.md
!.codex/manual-agent-prompt-template.md
!.codex/hooks.json
!.codex/stranded-commit-allowlist.txt
!.codex/stages/
!.codex/stages/**
# Closeout run state, not stage evidence. `.codex/stages/**` un-ignores the whole
# subtree, so these have to be named back out or a closeout leaves its locks in
# the commit — which is how they reached `master` once on 2026-08-07.
# Named individually once; a third one (.telemetry.json.lock) appeared on
# 2026-08-08 and slipped past, so match every dotted lock instead.
.codex/stages/**/.*.lock

# --- Build Outputs & Cache ---
dist/
build/
# `build/` is meant for build *outputs*. It also swallowed a build *input*:
# src/build/generate-config-seed.ts, the script that refreshes the offline model
# routing fallback from the database, was never in Git and so never reached CI
# or a fresh clone. Found 2026-08-12 while chasing mc2-db696.121.
!packages/course-gen-platform/src/build/
.next/
*.tsbuildinfo
.eslintcache
.cache/

# --- Career Playbook live-smoke artifacts (final_markdown + cost snapshots) ---
packages/course-gen-platform/artifacts/

# --- Environment Variables & Secrets (CRITICAL) ---
.env
.env.local
.env.development
.env.test
.env.production
*.env
*.env.local

