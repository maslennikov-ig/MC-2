# ===================================================================
# MCP Server Configuration Template
# ===================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in your actual credentials in .env.local
# 3. Never commit .env.local to git (it's in .gitignore)

# Supabase Configuration
# ===================================================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Main Supabase Instance (MegaCampusAI)
SUPABASE_PROJECT_REF=your_main_project_ref_here
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here
SUPABASE_DB_PASSWORD=your_database_password_here

# Supabase Edge Functions (for cleanup job)
SUPABASE_URL=https://your_main_project_ref_here.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Legacy Supabase Instance (if you have one)
SUPABASE_LEGACY_PROJECT_REF=your_legacy_project_ref_here

# Sequential Thinking MCP Server
# ===================================================================
# Get these from: https://smithery.ai/
SEQUENTIAL_THINKING_KEY=your_smithery_api_key_here
SEQUENTIAL_THINKING_PROFILE=your_smithery_profile_here

# GitHub Configuration
# ===================================================================
# Get these from: https://github.com/settings/tokens
# GITHUB_TOKEN: Classic token with repo access
# GITHUB_PAT: Fine-grained Personal Access Token
GITHUB_TOKEN=your_github_token_here
GITHUB_PAT=your_github_pat_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# NotebookLM Bridge (Stage 7 Enrichments)
# ===================================================================
# NOTEBOOKLM_BRIDGE_URL for local host access to docker-compose.dev.yml service.
# API/worker containers use the internal service URL from compose.
NOTEBOOKLM_BRIDGE_URL=http://localhost:8010
# Shared bearer token used by API/worker -> bridge requests and bridge auth.
NOTEBOOKLM_BRIDGE_TOKEN=your_shared_notebooklm_bridge_token_here
# API/worker HTTP timeout when calling NotebookLM bridge (default: 60 minutes).
NOTEBOOKLM_BRIDGE_TIMEOUT_MS=3600000
# Per-poll HTTP timeout for async task status/result requests (default: 30 seconds).
NOTEBOOKLM_BRIDGE_POLL_REQUEST_TIMEOUT_MS=30000
NOTEBOOKLM_LOG_LEVEL=INFO
# Preferred for dev/stage/prod: inline NotebookLM auth JSON from secret manager.
# Leave NOTEBOOKLM_STORAGE_PATH empty when this is set.
# Example format: {"cookies":[...],"origins":[...]}
NOTEBOOKLM_AUTH_JSON=
# Local file fallback: host directory containing notebooklm-py browser auth state.
NOTEBOOKLM_STORAGE_STATE_DIR=./secrets/notebooklm
# Optional in-container file path for file fallback mode only.
NOTEBOOKLM_STORAGE_PATH=
# Optional: notebooklm-py home dir used by file fallback/download auth helpers.
NOTEBOOKLM_HOME=/app/secrets/notebooklm
# Bridge-side generation and queue wait timeouts (default: 60 minutes).
NOTEBOOKLM_GENERATION_TIMEOUT_SECONDS=3600
NOTEBOOKLM_QUEUE_WAIT_TIMEOUT_SECONDS=3600
# Per-request HTTP timeout used by notebooklm-py polling (keep much smaller than generation timeout).
NOTEBOOKLM_HTTP_TIMEOUT_SECONDS=60
# How many transient poll errors bridge tolerates before failing.
NOTEBOOKLM_POLL_ERROR_RETRY_LIMIT=12
# Strict mode by default: fail generation if upstream auth/state is unavailable.
NOTEBOOKLM_ALLOW_FALLBACK=false

# Next.js Server Actions Encryption
# ===================================================================
# Required for persistent Server Action IDs across builds/deployments
# Generate: openssl rand -base64 32
# Docs: https://nextjs.org/docs/messages/failed-to-find-server-action
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your_32_byte_base64_key_here
