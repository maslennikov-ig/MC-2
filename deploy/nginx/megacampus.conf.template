# MegaCampus AI Production Configuration - Blue/Green Template
# {{COLOR}} will be replaced with "blue" or "green"
# {{WEB_PORT}} and {{API_PORT}} will be replaced with actual ports
#
# IMPORTANT: This is the SINGLE SOURCE OF TRUTH for production nginx config.
# Do NOT edit /etc/nginx/sites-enabled/megacampus directly on the server.
# Changes should be made here and deployed via CI/CD.

# Upstream for Next.js web app (Blue/Green)
upstream megacampus_web {
    server 127.0.0.1:{{WEB_PORT}};
    keepalive 64;
}

# Upstream for API server (Blue/Green)
upstream megacampus_api {
    server 127.0.0.1:{{API_PORT}};
    keepalive 64;
}

# Rate limiting zone for enrichment storage (prevent abuse)
# 10MB zone (~160,000 IPs), 50 requests/second per IP
limit_req_zone $binary_remote_addr zone=enrichments_limit:10m rate=50r/s;

# HTTP to HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name ai.megacampus.ru;

    # Allow Let's Encrypt challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all other traffic to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# Main HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ai.megacampus.ru;

    # SSL certificates
    ssl_certificate /etc/letsencrypt/live/ai.megacampus.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai.megacampus.ru/privkey.pem;

    # SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Logging
    access_log /var/log/nginx/megacampus.access.log;
    error_log /var/log/nginx/megacampus.error.log;

    # Client body size (for file uploads)
    client_max_body_size 100M;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Static enrichment files - served directly by nginx (covers, cards)
    location /storage/enrichments/ {
        limit_req zone=enrichments_limit burst=100 nodelay;
        limit_req_status 429;

        alias /opt/megacampus/data/enrichments/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff";

        # CORS for client-side image access
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;

        # Enable ETag for conditional requests
        etag on;

        types { image/webp webp; image/png png; image/jpeg jpeg jpg; }
        default_type image/webp;
        try_files $uri =404;
    }

    # API routes - proxy to Express/tRPC
    # Rewrite /api/trpc/* to /trpc/* because Express mounts tRPC on /trpc
    location /api/trpc/ {
        add_header Cache-Control "no-store" always;

        rewrite ^/api/trpc/(.*)$ /trpc/$1 break;
        proxy_pass http://megacampus_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    # Bull Board (job monitoring) - restricted access
    location /admin/queues {
        allow 127.0.0.1;
        allow 95.81.98.230;
        allow 185.200.177.180;
        allow 80.74.28.160;
        deny all;

        proxy_pass http://megacampus_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check endpoint (API)
    location /health {
        proxy_pass http://megacampus_api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Next.js static files
    location /_next/static {
        proxy_pass http://megacampus_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_valid 200 60m;
        add_header Cache-Control "public, immutable, max-age=31536000";
    }

    # Next.js public files
    location /public {
        proxy_pass http://megacampus_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # All other routes - Next.js app
    location / {
        # Fix for "upstream sent too big header" 502 errors
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        proxy_headers_hash_max_size 512;
        proxy_headers_hash_bucket_size 128;

        # Prevent browser caching of HTML pages
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;

        proxy_pass http://megacampus_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
