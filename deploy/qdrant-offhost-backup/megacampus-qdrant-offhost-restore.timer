[Unit]
Description=Weekly exact-version restore from off-host Qdrant snapshot

[Timer]
# The daily pull starts at 04:20 with up to 20 minutes of jitter and has a
# one-hour timeout. Leave room for it to finish before taking the shared lock.
# A weekly schedule retries after a missed run before the 35-day alert threshold.
OnCalendar=Sun *-*-* 06:00:00
RandomizedDelaySec=30m
AccuracySec=1m
Persistent=true
Unit=megacampus-qdrant-offhost-restore.service

[Install]
WantedBy=timers.target
