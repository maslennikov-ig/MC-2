[Unit]
Description=MegaCampus Qdrant authenticated snapshot and retention
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=megacampus
Group=megacampus
WorkingDirectory=/opt/megacampus/packages/course-gen-platform
UMask=0077
LoadCredential=qdrant_api_key:/opt/megacampus/secrets/qdrant_api_key
Environment=QDRANT_URL=http://127.0.0.1:6335
Environment=QDRANT_API_KEY_FILE=%d/qdrant_api_key
Environment=QDRANT_COLLECTION_NAME=course_embeddings
Environment=QDRANT_SNAPSHOT_STORAGE_MODE=s3
Environment=QDRANT_SNAPSHOT_OBJECT_PREFIX=megacampus/qdrant
Environment=QDRANT_RECOVERY_STATE_DIR=/var/lib/megacampus-qdrant-recovery
Environment=QDRANT_METRICS_TEXTFILE_DIR=/var/lib/megacampus/qdrant-metrics
Environment=QDRANT_RECOVERY_LOCK_PATH=/run/megacampus-qdrant-recovery/recovery.lock
Environment=QDRANT_RECOVERY_LOCK_HELD=1
ExecStartPre=/usr/bin/bash -eu -c 'test -d "$1" && test ! -L "$1" && test -w "$1" && test "$(/usr/bin/stat -c %%a -- "$1")" = 2775' -- /var/lib/megacampus/qdrant-metrics
ExecStart=/usr/bin/flock --nonblock /run/megacampus-qdrant-recovery/recovery.lock /usr/bin/pnpm --dir /opt/megacampus/packages/course-gen-platform qdrant:snapshot
TimeoutStartSec=55m
StateDirectory=megacampus-qdrant-recovery
StateDirectoryMode=0700
RuntimeDirectory=megacampus-qdrant-recovery
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/megacampus-qdrant-recovery /var/lib/megacampus/qdrant-metrics /run/megacampus-qdrant-recovery
