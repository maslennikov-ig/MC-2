[Unit]
Description=MegaCampus Qdrant authenticated snapshot and retention
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
LoadCredential=qdrant_api_key:/opt/megacampus/secrets/qdrant_api_key
Environment=QDRANT_URL=http://qdrant:6333
Environment=QDRANT_API_KEY_FILE=/run/megacampus-qdrant-snapshot-credentials/qdrant_api_key
Environment=QDRANT_COLLECTION_NAME=course_embeddings
Environment=QDRANT_SNAPSHOT_STORAGE_MODE=s3
Environment=QDRANT_SNAPSHOT_OBJECT_PREFIX=megacampus/qdrant
Environment=QDRANT_RECOVERY_STATE_DIR=/var/lib/megacampus-qdrant-recovery
Environment=QDRANT_METRICS_TEXTFILE_DIR=/var/lib/megacampus/qdrant-metrics
Environment=QDRANT_RECOVERY_LOCK_PATH=/run/megacampus-qdrant-recovery/recovery.lock
Environment=QDRANT_RECOVERY_LOCK_HELD=1
ExecStartPre=/usr/bin/chown 1001:1001 /var/lib/megacampus-qdrant-recovery
ExecStartPre=/usr/bin/install -o 0 -g 0 -m 0400 %d/qdrant_api_key /run/megacampus-qdrant-snapshot-credentials/qdrant_api_key
ExecStartPre=/opt/megacampus/deploy/qdrant/operator-compose.sh --project-directory /opt/megacampus -f /opt/megacampus/docker-compose.infra.yml --env-file /opt/megacampus/.env.production --profile operator run --rm --no-deps -T qdrant-recovery-operator metrics-check
ExecStart=/usr/bin/flock --nonblock /run/megacampus-qdrant-recovery/recovery.lock /opt/megacampus/deploy/qdrant/operator-compose.sh --project-directory /opt/megacampus -f /opt/megacampus/docker-compose.infra.yml --env-file /opt/megacampus/.env.production --profile operator run --rm --no-deps -T -e QDRANT_RECOVERY_LOCK_HELD=1 qdrant-recovery-operator snapshot
TimeoutStartSec=55m
StateDirectory=megacampus-qdrant-recovery
StateDirectoryMode=0700
RuntimeDirectory=megacampus-qdrant-recovery megacampus-qdrant-snapshot-credentials
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/megacampus-qdrant-recovery /var/lib/megacampus/qdrant-metrics /run/megacampus-qdrant-recovery
