[Unit]
Description=MegaCampus Qdrant isolated authenticated restore drill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
LoadCredential=qdrant_api_key:/opt/megacampus/secrets/qdrant_api_key
LoadCredential=snapshot_manifest:/var/lib/megacampus-qdrant-recovery/manifests/latest-manifest.json
LoadCredential=recovery_probe:/opt/megacampus/recovery/probe.json
Environment=QDRANT_URL=http://qdrant:6333
Environment=QDRANT_SNAPSHOT_TRANSPORT_URL=http://qdrant:6333
Environment=QDRANT_API_KEY_FILE=/var/lib/megacampus-qdrant-recovery/runtime/restore/qdrant_api_key
Environment=QDRANT_SNAPSHOT_MANIFEST_FILE=/var/lib/megacampus-qdrant-recovery/runtime/restore/snapshot_manifest
Environment=QDRANT_RECOVERY_PROBE_FILE=/var/lib/megacampus-qdrant-recovery/runtime/restore/recovery_probe
Environment=QDRANT_COLLECTION_NAME=course_embeddings
Environment=QDRANT_RECOVERY_STATE_DIR=/var/lib/megacampus-qdrant-recovery
Environment=QDRANT_METRICS_TEXTFILE_DIR=/var/lib/megacampus/qdrant-metrics
Environment=QDRANT_RECOVERY_LOCK_PATH=/run/megacampus-qdrant-recovery/recovery.lock
Environment=QDRANT_RECOVERY_LOCK_HELD=1
ExecStartPre=/usr/bin/chown 1001:1001 /var/lib/megacampus-qdrant-recovery
ExecStartPre=/usr/bin/install -D -o 0 -g 0 -m 0400 %d/qdrant_api_key /var/lib/megacampus-qdrant-recovery/runtime/restore/qdrant_api_key
ExecStartPre=/usr/bin/install -D -o 0 -g 0 -m 0400 %d/snapshot_manifest /var/lib/megacampus-qdrant-recovery/runtime/restore/snapshot_manifest
ExecStartPre=/usr/bin/install -D -o 0 -g 0 -m 0400 %d/recovery_probe /var/lib/megacampus-qdrant-recovery/runtime/restore/recovery_probe
ExecStartPre=/usr/bin/bash -eu -c 'test -d "$1" && test ! -L "$1" && test -w "$1" && test "$(/usr/bin/stat -c %%a -- "$1")" = 2775' -- /var/lib/megacampus/qdrant-metrics
ExecStart=/usr/bin/flock --nonblock /run/megacampus-qdrant-recovery/recovery.lock /usr/bin/docker compose --project-directory /opt/megacampus -f /opt/megacampus/docker-compose.infra.yml --env-file /opt/megacampus/.env.production --profile operator run --rm --no-deps -T qdrant-restore-operator restore-drill
ExecStopPost=/usr/bin/rm -rf /var/lib/megacampus-qdrant-recovery/runtime/restore
TimeoutStartSec=55m
StateDirectory=megacampus-qdrant-recovery
StateDirectoryMode=0700
RuntimeDirectory=megacampus-qdrant-recovery
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/megacampus-qdrant-recovery /var/lib/megacampus/qdrant-metrics /run/megacampus-qdrant-recovery
