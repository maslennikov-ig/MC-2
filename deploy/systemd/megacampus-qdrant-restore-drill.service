[Unit]
Description=MegaCampus Qdrant isolated authenticated restore drill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
LoadCredential=qdrant_api_key:/opt/megacampus/secrets/qdrant_api_key
LoadCredential=snapshot_manifest:/var/lib/megacampus-qdrant-recovery/manifests/latest-manifest.json
LoadCredential=recovery_probe:/opt/megacampus/recovery/probe.json
Environment=QDRANT_URL=http://qdrant:6333
Environment=QDRANT_SNAPSHOT_TRANSPORT_URL=http://qdrant:6333
Environment=QDRANT_API_KEY_FILE=/run/megacampus-qdrant-restore-credentials/qdrant_api_key
Environment=QDRANT_SNAPSHOT_MANIFEST_FILE=/run/megacampus-qdrant-restore-credentials/snapshot_manifest
Environment=QDRANT_RECOVERY_PROBE_FILE=/run/megacampus-qdrant-restore-credentials/recovery_probe
Environment=QDRANT_COLLECTION_NAME=course_embeddings
Environment=QDRANT_RECOVERY_STATE_DIR=/var/lib/megacampus-qdrant-recovery
Environment=QDRANT_METRICS_TEXTFILE_DIR=/var/lib/megacampus/qdrant-metrics
Environment=QDRANT_RECOVERY_LOCK_PATH=/run/megacampus-qdrant-recovery/recovery.lock
Environment=QDRANT_RECOVERY_LOCK_HELD=1
# systemd re-asserts StateDirectory ownership for every command it forks, so with
# StateDirectory= set this chown was undone before ExecStart ran and the tool uid met
# "EACCES: permission denied, open '/var/lib/megacampus-qdrant-recovery/metrics-state.json'".
# The directory is a deployment prerequisite and ReadWritePaths already makes it writable
# under ProtectSystem=strict, so systemd does not need to own it.
ExecStartPre=/usr/bin/chown 1001:1001 /var/lib/megacampus-qdrant-recovery
ExecStartPre=/usr/bin/chmod 0700 /var/lib/megacampus-qdrant-recovery
ExecStartPre=/usr/bin/install -o 0 -g 0 -m 0400 %d/qdrant_api_key /run/megacampus-qdrant-restore-credentials/qdrant_api_key
ExecStartPre=/usr/bin/install -o 0 -g 0 -m 0400 %d/snapshot_manifest /run/megacampus-qdrant-restore-credentials/snapshot_manifest
ExecStartPre=/usr/bin/install -o 0 -g 0 -m 0400 %d/recovery_probe /run/megacampus-qdrant-restore-credentials/recovery_probe
ExecStartPre=/opt/megacampus/deploy/qdrant/operator-compose.sh --project-directory /opt/megacampus -f /opt/megacampus/docker-compose.infra.yml --env-file /opt/megacampus/.env.production --profile operator run --rm --no-deps -T qdrant-recovery-operator metrics-check
ExecStart=/usr/bin/flock --nonblock /run/megacampus-qdrant-recovery/recovery.lock /opt/megacampus/deploy/qdrant/operator-compose.sh --project-directory /opt/megacampus -f /opt/megacampus/docker-compose.infra.yml --env-file /opt/megacampus/.env.production --profile operator run --rm --no-deps -T -e QDRANT_RECOVERY_LOCK_HELD=1 qdrant-restore-operator restore-drill
TimeoutStartSec=55m
RuntimeDirectory=megacampus-qdrant-recovery megacampus-qdrant-restore-credentials
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/megacampus-qdrant-recovery /var/lib/megacampus/qdrant-metrics /run/megacampus-qdrant-recovery
