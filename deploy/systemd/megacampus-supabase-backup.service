[Unit]
Description=MegaCampus atomic Supabase backup generation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=claude-deploy
Group=claude-deploy
UMask=0077
WorkingDirectory=/opt/megacampus
ExecStart=/opt/megacampus/deploy/postgres/scheduled-backup-run.sh
TimeoutStartSec=2h
StandardOutput=append:/opt/megacampus/logs/backup-supabase.log
StandardError=append:/opt/megacampus/logs/backup-supabase.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/megacampus/deploy /opt/megacampus/secrets
ReadWritePaths=/opt/megacampus/backups/supabase /opt/megacampus/logs
