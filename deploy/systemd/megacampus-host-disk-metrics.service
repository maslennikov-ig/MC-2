[Unit]
Description=Publish MegaCampus host filesystem capacity as Prometheus textfile metrics
Documentation=https://github.com/maslennikov-ig/MC-2 mc2-adb6y

[Service]
Type=oneshot
UMask=0022
Environment=QDRANT_METRICS_TEXTFILE_DIR=/var/lib/megacampus/qdrant-metrics
ExecStart=/opt/megacampus/ops/qdrant/textfile/publish-disk-metrics.sh \
  ${QDRANT_METRICS_TEXTFILE_DIR}/megacampus_host_disk.prom /
# Reads df and writes one small file. Nothing here needs privilege beyond write
# access to the textfile directory, which is group-owned by megacampus-metrics.
User=claude-deploy
Group=megacampus-metrics
ReadWritePaths=/var/lib/megacampus/qdrant-metrics
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
