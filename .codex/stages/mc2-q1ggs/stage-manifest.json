    "criteria": [
      {
        "criterion_id": "AC-1",
        "text": "Production, development, rollback, and legacy deploy entrypoints acquire one shared non-blocking host lock before any Docker, Nginx, or service mutation; a concurrent operation exits nonzero without running its command.",
        "text_digest": "6568db0e594bdde270cf41a1be9edb0028bc2dcdbb38925304ef99a8d055be6f"
      },
      {
        "criterion_id": "AC-2",
        "text": "A generic infrastructure wrapper holds the same lock for the full child-command lifetime, identifies the requested operation without exposing secrets, and releases the kernel lock automatically when the process exits.",
        "text_digest": "40844fb92cf368edd673493aff61b808ba0da483707b72c9394e2db5d11dac55"
      },
      {
        "criterion_id": "AC-3",
        "text": "The deployment workflow ships the lock helper to the host, changes to the helper trigger deployment, and focused contention tests, deploy contract tests, type-check, and build pass without SSH, deploy, access, secret, migration, reindex, or paid work.",
        "text_digest": "b0969eea4bdb5eca4b59428c8745d43d6789f832c7aba54fa231c6dcd207f775"
      }
    ]
  },
